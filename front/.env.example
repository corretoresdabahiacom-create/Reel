# NexusReel – Fase 3. Copie para .env. NUNCA faça commit do .env.
# Chave mestra: false = mocks (padrão). true = APIs reais (exige backend em execução).
USE_REAL_APIS=false
BACKEND_URL=http://localhost:8787
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
PORT=8787

# Estado de aprovação dos apps (muda o que a plataforma permite)
TIKTOK_APP_AUDITED=false
YOUTUBE_PROJECT_VERIFIED=false

# TikTok (developers.tiktok.com) – produto "Content Posting API"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube (Google Cloud Console) – YouTube Data API v3, OAuth client "Web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram (Meta for Developers) – Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Temu (parceiros) – TODO confirmar
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_AUTH_URL=
TEMU_API_BASE=
# OLX (parceiros) – TODO confirmar
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_AUTH_URL=
OLX_API_BASE=
# Mercado Livre
MELI_APP_ID=
MELI_CLIENT_SECRET=

# Segurança: chave (32 bytes base64) para criptografar tokens em repouso
TOKEN_ENCRYPTION_KEY=

# ---- Fase 4 ----
# Afiliados (credenciais só no backend). Shopee Afiliados: AppID/Secret; Mercado Livre Afiliados: ID da conta/tag
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
MELI_AFFILIATE_TAG=
TRACKING_BASE_URL=https://app.nexusreel.com/r
# Admin: e-mails com isAdmin=true (separados por vírgula). A checagem é SEMPRE feita no servidor.
ADMIN_EMAILS=admin@nexusreel.com
# Pagamentos/saques (Stripe Connect / Mercado Pago / Pagar.me) – TODO: depende de contrato e aprovação
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
# Fila de lotes (BullMQ/Redis)
REDIS_URL=redis://localhost:6379
# Taxas padrão (ajustáveis no painel Admin → Configurações)
MARKETPLACE_FEE_PCT=20
AFFILIATE_FEE_PCT=10
MIN_PAYOUT_CENTS=5000
