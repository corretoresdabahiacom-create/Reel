{
  "name": "nexusreel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:dry": "tsx src/db/migrate.ts dry",
    "openapi": "tsx scripts/gen-response-types.ts && tsx scripts/gen-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "load": "k6 run load/redirect.js",
    "slo:generate": "tsx tools/slo-generator/index.ts generate",
    "slo:check": "tsx tools/slo-generator/index.ts check",
    "onboarding:validate": "tsx tools/onboarding-checklist/index.ts validate",
    "i18n:check": "tsx tools/i18n-check/index.ts check",
    "finops:report": "tsx tools/finops-report/index.ts",
    "incident": "tsx tools/incident-bot/index.ts",
    "postmortem": "tsx tools/postmortem-generator/index.ts",
    "bcp": "tsx tools/bcp-simulator/index.ts",
    "contract": "tsx tools/contract-generator/index.ts",
    "dpia": "tsx tools/dpia-assistant/index.ts",
    "dataroom:sync": "tsx tools/data-room-sync/index.ts sync",
    "dataroom:check": "tsx tools/data-room-sync/index.ts check",
    "audit:licenses": "tsx tools/compliance-audit/index.ts licenses",
    "audit:sbom": "tsx tools/compliance-audit/index.ts sbom",
    "audit:access": "tsx tools/compliance-audit/index.ts access",
    "compliance:docs": "tsx tools/compliance-audit/docs.ts",
    "compliance:docs:check": "tsx tools/compliance-audit/docs.ts --check",
    "i18n:docs": "tsx tools/i18n-check/docs.ts",
    "taxonomy:docs": "tsx scripts/gen-taxonomy-doc.ts",
    "taxonomy:check": "tsx scripts/gen-taxonomy-doc.ts --check",
    "rls:docs": "tsx scripts/gen-rls-doc.ts",
    "rls:check": "tsx scripts/gen-rls-doc.ts --check",
    "secrets:scan": "node tools/secret-scan/index.mjs .",
    "openapi:record": "tsx scripts/gen-response-types.ts && OPENAPI_RECORD=1 vitest run && tsx scripts/gen-openapi.ts && tsx tools/data-room-sync/index.ts sync"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/cloudfront-signer": "3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/fastify": "^9.10.4",
    "@contentauth/c2pa-node": "0.9.9",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/websocket": "^11.3.3",
    "@gradio/client": "^2.7.2",
    "@opentelemetry/api": "^1.9.0",
    "@sentry/node": "^8.30.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.12.0",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "jose": "^5.8.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.0.5",
    "ajv": "8.20.0",
    "eslint": "^9.9.0",
    "s3rver": "3.7.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.0.5",
    "zod-to-json-schema": "3.25.2"
  }
}
