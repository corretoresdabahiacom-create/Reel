# ===== NexusReel backend — copie para .env (NUNCA commitar segredos) =====
NODE_ENV=development
# Instalação gratuita (docs/FREE.md): APP_PROFILE=free aceita IA simulada/voz aberta, arquivos no disco (caminho absoluto)
# e exige PAYMENTS_MODE=off. standard = perfil completo (S3/AWS, provedores pagos).
APP_PROFILE=standard                  # standard | free
PORT=8787
REGION=sa-east-1                      # região desta instância (sa-east-1 | us-east-1 | eu-west-1)
PUBLIC_API_URL=http://localhost:8787
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://app.nexusreel.com
TRUSTED_PROXY=false

# --- Postgres / Redis ---
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexusreel
DATABASE_READ_URL=                    # réplica de leitura (opcional)
REDIS_URL=redis://localhost:6379

# --- Auth (gere com: openssl rand -base64 48) ---
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ISSUER=nexusreel
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000
ADMIN_REQUIRE_TOTP=true
MOCK_OAUTH=false                      # true só em dev/test: code "mock:<email>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
META_APP_ID=
META_APP_SECRET=

# --- Criptografia em repouso (AES-256-GCM): 32 bytes em base64. Em prod vem do KMS/Secrets Manager. ---
DATA_ENCRYPTION_KEY=                  # openssl rand -base64 32
DATA_ENCRYPTION_KEY_ID=k1
IP_HASH_SALT=change-me

# --- Storage: local (disco; padrão gratuito) ou S3-compatível (S3/R2, migração futura — docs/FREE.md) ---
STORAGE_DRIVER=local                  # local | s3
LOCAL_STORAGE_DIR=./.storage          # produção gratuita: caminho absoluto num volume persistente (ex.: /data/storage)
S3_ENDPOINT=                          # vazio = AWS S3; ou o endpoint do provedor compatível
S3_REGION=sa-east-1
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=nexus-uploads
S3_BUCKET_VIDEOS=nexus-videos
S3_BUCKET_EXPORTS=nexus-exports
S3_BUCKET_ARCHIVE=nexus-archive      # Módulo 5: Nuvem NexusReel (longo prazo, separado do storage dos projetos)
CDN_BASE_URL=                         # vazio = links assinados da própria API (local) ou do S3; CloudFront na migração
SIGNED_URL_TTL_SEC=3600
S3_KMS_KEY_ID=                        # SSE-KMS explícita; vazio = criptografia padrão do bucket (KMS no Terraform). Não use AES256 fixo.
CLOUDFRONT_KEY_PAIR_ID=               # CDN com URL assinada: só liga com CDN_BASE_URL (https) + par de chaves; senão usa URL pré-assinada do S3
CLOUDFRONT_PRIVATE_KEY=               # PEM da chave privada (\n escapado aceito); em produção vem do Secrets Manager (Terraform gera)
PROJECT_PURGE_DELAY_SEC=0             # projeto excluído: segundos até apagar vídeo/cenas/fotos do storage (0 = logo, em segundo plano)
PROJECT_PURGE_RECHECK_SEC=7200         # 2ª passada da limpeza: apaga o que um job em andamento gravou depois (maior que o job mais longo, ~30 min)

# --- IA ---
AI_VIDEO_PROVIDER=mock                # mock | kling   (fallback: AI_VIDEO_FALLBACK)
AI_VIDEO_FALLBACK=mock
AI_TTS_PROVIDER=mock                  # mock | elevenlabs | espeak | piper | kokoro | open (abertas: custo 0; open = melhor voz instalada)
AI_TTS_FALLBACK=mock                  # voz reserva quando a principal falha (ex.: piper sem modelo → espeak)
ESPEAK_BIN=espeak-ng
PIPER_BIN=piper
PIPER_VOICES_DIR=/opt/piper/voices    # modelos .onnx (baixados no build do Docker)
PIPER_VOICE_PT_BR=                    # vazio = pt_BR-faber-medium
PIPER_VOICE_EN=                       # vazio = en_US-amy/ryan/lessac-medium (por gênero)
PIPER_VOICE_ES=                       # vazio = es_ES-davefx-medium
KOKORO_PYTHON=python3                 # Kokoro-82M (Apache-2.0) via kokoro-onnx; AI_TTS_PROVIDER=open escolhe a melhor voz instalada
KOKORO_SCRIPT=tools/kokoro/speak.py
KOKORO_MODEL=/opt/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES=/opt/kokoro/voices-v1.0.bin
# Módulo 1 — Áudio (só com a flag ff_audio ligada). Por enquanto só há provedores mock (FFmpeg local).
AI_MUSIC_PROVIDER=mock                # mock | composer (música original com instrumentos reais, FluidSynth)
AI_VOICE_CLONE_PROVIDER=mock          # mock (provedor real exige contrato com opt-out de treino)
AUDIO_STEM_URL_TTL_SEC=86400          # URLs assinadas de stems/mix: 24 h
AUDIO_VERSION_RETENTION_DAYS=90       # versões de áudio não usadas são apagadas depois disso
VOICE_SAMPLE_MAX_BYTES=5242880        # amostra de voz do consentimento: até 5 MB
# Módulo 2 — Edição de fundo (só com ff_background). Só provedor mock (FFmpeg local) por enquanto.
AI_BACKGROUND_PROVIDER=mock           # mock
BACKGROUND_URL_TTL_SEC=86400          # URLs assinadas das versões editadas: 24 h
# Módulo 3 — Inserção de elementos (só com ff_elements). Só provedor mock (FFmpeg local) por enquanto.
AI_ELEMENTS_PROVIDER=mock             # mock
# Módulo 4 — União de vídeos (só com ff_merge)
MERGE_MAX_SEC=120                     # duração máxima do vídeo unido
MERGE_INPUT_MAX_SEC=61                # duração máxima de cada vídeo de entrada
MERGE_URL_TTL_SEC=86400               # URLs assinadas do resultado: 24 h
AI_MODERATION_PROVIDER=mock           # mock | openai
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api.klingai.com
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
AI_DAILY_COST_ALERT_CENTS=50000
AI_COST_LIMIT_FREE_CENTS=200
AI_COST_LIMIT_PRO_CENTS=2000
AI_COST_LIMIT_BUSINESS_CENTS=20000

# --- Plataformas (client secrets SÓ aqui) ---
PLATFORM_MODE=mock                    # mock | real
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_APP_AUDITED=false
YOUTUBE_PROJECT_VERIFIED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=       # token próprio do webhook do Instagram (não reutilize outros segredos)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_AUTH_URL=
TEMU_API_BASE=
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_AUTH_URL=
OLX_API_BASE=
MELI_APP_ID=
MELI_CLIENT_SECRET=
AFFILIATE_WEBHOOK_SECRET=change-me   # HMAC dos webhooks de conversão

# --- Pagamentos ---
PAYMENTS_MODE=mock                    # mock | real | off (off: checkout/Pix/saques/webhooks → 503 payments_disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_LOW=   # experimento de preço (paywall_price): Price ID Stripe da variante -20%
STRIPE_PRICE_PRO_HIGH=  # variante +20%
STRIPE_PRICE_BUSINESS=
STRIPE_CONNECT_CLIENT_ID=
PIX_PROVIDER=mercadopago              # mercadopago | pagarme
MERCADOPAGO_ACCESS_TOKEN=
PAGARME_API_KEY=
PIX_WEBHOOK_SECRET=change-me

# --- E-mail ---
EMAIL_PROVIDER=log                    # log | resend | ses
RESEND_API_KEY=
EMAIL_FROM=NexusReel <no-reply@nexusreel.com>

# --- Observabilidade ---
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=0.1
METRICS_ALLOW_CIDRS=127.0.0.1/32,10.0.0.0/8
METRICS_TOKEN=
BULL_BOARD_ENABLED=true

# --- Operação ---
WORKER_CONCURRENCY_SCALE=1            # multiplica as concorrências padrão
QUEUE_PREFIX=bull                     # prefixo das chaves do BullMQ no Redis (os testes usam nxtest para não disputar jobs com o dev)

# --- Operação avançada (opcionais) ---
EMBED_WORKERS=false                   # true: API + workers no mesmo processo (dev)
RUN_MIGRATIONS=false                  # true: aplica migrations ao subir a API (use job dedicado em produção)
MIGRATE_DATABASE_URL=                 # URL com privilégios de DDL para o job de migrations (padrão: DATABASE_URL)
WORKER_QUEUES=                        # lista separada por vírgula p/ dedicar o pool a filas (ex.: generation-assemble,dubbing-video)
WORKER_METRICS_PORT=9464              # /metrics e /healthz do processo worker
QUEUE_BACKOFF_MS=2000                 # base do backoff exponencial dos jobs (3 tentativas)
CLICK_FLUSH_MS=5000                   # intervalo de consolidação dos cliques de afiliado (Redis → Postgres)
PUBLISH_POLL_MS=3000                  # intervalo de polling do status de publicação
PUBLISH_POLL_MAX=100                  # máx. de polls antes de erro retentável
OLX_WAIT_MS=600000                    # tempo máx. esperando o YouTube concluir antes de publicar na OLX
YT_DAILY_UNITS=10000                  # cota diária da YouTube Data API (upload = 1600 unidades)
ELEVENLABS_VOICE_DEFAULT=             # voice_id padrão da dublagem
OTEL_SERVICE_NAME=nexusreel-api
APP_VERSION=dev                       # injetado pelo CI (SHA)

# --- Somente testes/simulação de falhas (NUNCA em produção) ---
# MOCK_FAIL_SCENE_INDEX=6             # falha a cena de índice N até ser refeita (retried=true)
# MOCK_PLATFORM_FAIL=tiktok:fatal     # falha plataforma (sufixo :fatal = não retentável)

# ── Fase 7: growth & data science ─────────────────────────────────────────────
ANALYTICS_PSEUDO_SALT=change-me          # HMAC do user_id enviado ao warehouse (trocar em produção; rotacionar exige reprocessar o warehouse)
WAREHOUSE_EXPORT_DIR=./.warehouse        # destino do export NDJSON incremental (em produção: bucket S3/GCS que o loader do BigQuery lê)
ML_SERVICE_URL=                          # serviço Python de churn/LTV (vazio → heurística local)
ML_TIMEOUT_MS=50                         # timeout curto: estourou → fallback
ML_SERVICE_TOKEN=
PUSH_PROVIDER=log                        # log | onesignal
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
GROWTH_JOBS_ENABLED=true                 # desliga jobs recorrentes de growth (guardrails, churn, RFM, lifecycle, export)
WAITLIST_PUBLIC_URL=https://nexusreel.com/waitlist

# --- Fase 8 (operação) — opcionais; sem eles os adaptadores rodam em modo log/stub ---
OPS_JOBS_ENABLED=true                  # coleta de SLI, avaliação de burn rate, snapshots de custo, retenção estendida
# SLACK_WEBHOOK_URL=                    # incident-bot: mensagens (não testado contra Slack real)
# SLACK_BOT_TOKEN=                      # incident-bot: criar canal #incident-<id> (conversations.create; não testado)
# PAGERDUTY_ROUTING_KEY=                # Events API v2 (não testado contra PagerDuty real)
STATUS_PUBLIC_URL=https://status.nexusreel.com
KYC_PROVIDER=stub                       # stub | persona | onfido (somente stub implementado)
SANCTIONS_PROVIDER=stub                 # stub | opensanctions (somente stub com lista local implementado)

# ── Auditoria pós-Fase 8: em NODE_ENV=production o boot falha com segredos padrão/curtos, PAYMENTS_MODE=mock,
# ADMIN_REQUIRE_TOTP=false ou stubs (IA, plataformas, KYC, sanções) sem reconhecimento explícito abaixo.
ALLOW_STUBS_IN_PRODUCTION=false

# ---- Módulo 5 — Salvamento (ff_save) ----
CLOUD_MODE=mock                       # mock | real (Google Drive, Dropbox, OneDrive)
KMS_DRIVER=local                      # local (dev) | aws — tokens de nuvem em envelope AES-256-GCM com chave de dados do KMS
KMS_KEY_ID=                           # ARN da chave KMS (obrigatório com KMS_DRIVER=aws)
GOOGLE_DRIVE_CLIENT_ID=               # escopo drive.file (só arquivos criados pelo app)
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=                      # app com acesso à pasta do app; escopo files.content.write
DROPBOX_APP_SECRET=
ONEDRIVE_CLIENT_ID=                   # Files.ReadWrite.AppFolder + offline_access
ONEDRIVE_CLIENT_SECRET=
NEXUS_CLOUD_RETENTION_FREE_DAYS=90
NEXUS_CLOUD_RETENTION_PRO_DAYS=365
NEXUS_CLOUD_QUOTA_FREE_MB=2048
NEXUS_CLOUD_QUOTA_PRO_MB=51200
SAVE_URL_TTL_SEC=86400                # links de download (mídia intermediária: 24 h)
SAVE_DEVICE_ZIP_DAYS=7                # ZIPs em lote para baixar ficam 7 dias
SAVE_BATCH_MAX_ITEMS=200

# --- Reauditoria 2026-10-21: variáveis lidas pelo código que faltavam aqui (teste: tests/19 ".env.example completo") ---
DB_APP_ROLE=nexus_app                 # papel sem BYPASSRLS que toda conexão da aplicação assume (fail-closed)
ASSETS_TTL_DAYS=30                    # Módulo 6 — assets derivados expiram
ASSETS_URL_TTL_SEC=86400              # links assinados de assets (24 h)
EDIT_URL_TTL_SEC=86400                # links assinados de edições (24 h)
EMAIL_SHARE_SECRET=                   # Módulo 7 — chave HMAC própria dos links de e-mail (vazio = derivada do JWT_SECRET)
EMAIL_SHARE_TTL_DAYS=7
EMAIL_SHARE_MAX_RECIPIENTS=20
EMAIL_SHARE_DAILY_RECIPIENTS=200
EMAIL_BLOCKED_DOMAINS=                # lista separada por vírgula
COLLAB_WS_AUTH_TIMEOUT_MS=5000        # Módulo 8 — prazo para o 1º "auth" no WebSocket
TIMELINE_SNAPSHOT_EVERY=20            # snapshot automático a cada N edições
AI_STT_PROVIDER=mock                  # Módulo 9 — mock | whisper (faster-whisper local, custo 0)
WHISPER_PYTHON=python3
WHISPER_SCRIPT=tools/whisper/transcribe.py
WHISPER_MODEL=small                   # tiny | base | small | medium (a imagem Docker baixa o base)
WHISPER_MODELS_DIR=/opt/whisper
DEEPGRAM_API_KEY=                     # só servidor
AI_AGENT_PROVIDER=mock
TRANSCRIPT_RETENTION_DAYS=90
INSIGHTS_MODEL=heuristic-v1           # Módulo 10 — rótulo "estimativa"
LIVE_AVATAR_PROVIDER=mock
TELEPROMPTER_MAX_BYTES=157286400      # Módulo 11 — 150 MB por gravação
SLACK_WEBHOOK_URL=                    # incident-bot / alertas (opcional)
SLACK_BOT_TOKEN=                      # só servidor (opcional)
PAGERDUTY_ROUTING_KEY=                # só servidor (opcional)
DEPLOY_REGION=global                  # Fase 8 — residência: br|eu|us recusa (421) usuário de outra região; global/vazio = não confere
A11Y_VISION_PROVIDER=mock             # Módulo 11 — descrição de cena (só mock até contratar)
C2PA_SIGNER=none                      # Módulo 10 — none | local | kms (selo C2PA)
C2PA_CERT_CHAIN_PEM_B64=              # cadeia de certificados (base64 PEM) — só servidor
C2PA_PRIVATE_KEY_PEM_B64=             # chave local (só dev; produção = KMS) — só servidor
C2PA_KMS_KEY_ID=                      # chave de assinatura no KMS (C2PA_SIGNER=kms)
C2PA_TRUST_ANCHORS_PEM_B64=           # âncoras de confiança extras para verificar selos
C2PA_TSA_URL=                         # carimbo de tempo RFC 3161 (opcional)
SESSION_COOKIE_SECURE=true            # P0-1 etapa 3: cookie de sessão com Secure (false só fora de produção, para http://localhost)
# PUBLIC_API_URL (acima): em produção, CORS_ORIGINS tem de ser do MESMO site que ela (cookie SameSite=Strict)
SESSION_COOKIE_DOMAIN=                # opcional: domínio do cookie (vazio = só o host da API)
# Só ferramentas/dev (não usar em produção): SLO_DIR, RLS_DIFF_LOG, MOCK_FAIL_SCENE_INDEX, MOCK_FAIL_MUSIC, MOCK_FAIL_BACKGROUND,
# MOCK_FAIL_ELEMENTS, MOCK_PLATFORM_FAIL, MOCK_CLOUD_FAIL, MOCK_CLOUD_GRANT, KLING_COST_CENTS_PER_5S,
# OPENAPI_RECORD (=1 só em `npm run openapi:record`: grava o contrato observado na suíte; ignorado em produção),
# CONTRACT_ENFORCE (=1 na suíte: valida toda resposta 2xx contra docs/openapi.yaml; ignorado em produção), CONTRACT_REPORT (arquivo .jsonl com as divergências)

# Login com Firebase Authentication (plano gratuito Spark). Vazio = rota /auth/firebase desligada (404).
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=          # só desenvolvimento/testes (emulador); produção recusa

# Música e estúdio de voz (ff_voice_studio)
FLUIDSYNTH_BIN=fluidsynth
MUSIC_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2
RECORDING_MAX_BYTES=31457280          # narração gravada: 30 MB
RECORDING_MAX_SEC=300                 # até 5 minutos
MUSIC_UPLOAD_MAX_BYTES=26214400       # música enviada: 25 MB
TTS_PREVIEW_MAX_CHARS=600

# Movimento humano nas fotos (opcional, grátis): Space aberto de imagem→vídeo (Wan 2.x). Vazio = só movimento de câmera.
HF_VIDEO_SPACE=
HF_VIDEO_API=
HF_TOKEN=
HF_TALK_SPACE=
HF_VIDEO_TIMEOUT_MS=180000

# Vozes neurais online da Microsoft (Edge TTS, não oficial, gratuita). 1 liga; se o serviço falhar, usa Kokoro/Piper.
EDGE_TTS=0
EDGE_PYTHON=
EDGE_SCRIPT=tools/edge/speak.py
