  "panels": [
    {
      "id": 32,
      "title": "Error budget (30d) — api/availability",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4.8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(slo:period_error_budget_remaining:ratio{sloth_service=\"api\", sloth_slo=\"availability\"}, 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
