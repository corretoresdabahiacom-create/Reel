# Instalação gratuita do NexusReel (docs/FREE.md). Copie para .env.free na raiz do backend e preencha.
# Domínio apontando para o servidor (o seu, ou um subdomínio gratuito como <nome>.duckdns.org). "localhost" para testar na sua máquina.
SITE_DOMAIN=localhost
# Pasta com o front (cópia da pasta web/ do repositório do front)
FRONT_DIR=./front

# Segredos: bash infra/free/gen-secrets.sh >> .env.free   (não versione este arquivo)

# Login com Firebase (opcional, plano gratuito Spark). Vazio = login por e-mail e senha do próprio app.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# Teste no celular (docker-compose.tunnel.yml): endereço do link temporário da Cloudflare. Vazio fora do teste.
TUNNEL_URL=
